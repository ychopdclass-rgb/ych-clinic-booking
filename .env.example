# Public Google Sheet identifiers. Never put patient data or private credentials here.
GOOGLE_SHEET_ID=replace-with-your-google-sheet-id
GOOGLE_SHEET_NAME=課堂資料

# Private Google Apps Script web-app URL used by the server-side booking route.
# Do not expose this value through a NEXT_PUBLIC_ variable.
BOOKING_SCRIPT_URL=https://script.google.com/macros/s/replace-with-your-deployment-id/exec
